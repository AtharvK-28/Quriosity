# The Quriosity server: accounts, synced progress, cohorts and the arena.
# Set these in the host's environment (Render → Environment). Never commit a real value.

# Postgres. Neon: copy the connection string from the project dashboard
# (it includes ?sslmode=require). Unset: an in-process database in DATA_DIR,
# which on Render's free tier is wiped on every redeploy.
DATABASE_URL=

# Signs login tokens. REQUIRED in production — the server refuses to start
# without it. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# Signing up with this code makes an instructor account. Share it only with
# instructors. Unset: nobody can sign up as an instructor.
INSTRUCTOR_CODE=TEACH-2026

# Comma-separated emails that become admin accounts when they sign up.
ADMIN_EMAILS=

# Local only: where the in-process database keeps its files. Default ./data.
# DATA_DIR=./data
